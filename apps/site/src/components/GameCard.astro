---
import type { GameView } from '../lib/data';
import { cardMeta, gameTitle } from '../lib/data';
import { gamePath, kindLabel, localePath, t, type Lang } from '../i18n';

interface Props {
  view: GameView;
  lang: Lang;
}

const { view, lang } = Astro.props;
const { game } = view;
const meta = cardMeta(view, lang);
const dateValue = Date.parse(view.date);
const title = gameTitle(view, lang);
---

<a
  class="game-card"
  href={localePath(lang, gamePath(game.slug))}
  title={title}
  data-game-card
  data-game-id={game.id}
  data-kind={game.kind}
  data-tags={game.tags.join(',')}
  data-controls={game.controls.join(',')}
  data-mobile={String(game.mobile)}
  data-stars={view.repoStats?.stars ?? ''}
  data-date={Number.isNaN(dateValue) ? 0 : dateValue}
>
  <span class="card-media">
    <img
      class="card-cover"
      src={view.coverUrl}
      alt={t(lang, 'common.coverAlt', { title })}
      width="800"
      height="500"
      loading="lazy"
      decoding="async"
    />
    {
      view.previewUrl && (
        <img
          class="card-preview"
          data-preview-src={view.previewUrl}
          alt=""
          width="800"
          height="500"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </span>
  <span class="card-title">{title}</span>
  <span class="card-meta">
    <span class="card-meta-left">
      {game.kind === 'demo' && <span class="card-kind">{kindLabel(lang, game.kind)} ·</span>}
      <span class="card-author">{meta.author}</span>
    </span>
    {meta.extra && <span class="card-extra">{meta.extra}</span>}
  </span>
</a>
