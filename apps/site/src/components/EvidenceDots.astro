---
import { evidenceLabel } from '../lib/data';
import type { Lang } from '../i18n';

interface Props {
  level: 'L1' | 'L2' | 'L3';
  notes?: string;
  lang: Lang;
}

const { level, notes, lang } = Astro.props;
const count = level === 'L1' ? 1 : level === 'L2' ? 2 : 3;
const label = evidenceLabel(lang, level, notes);
---

<span class="evidence" role="img" aria-label={label} tabindex="0" data-tooltip={label}>
  <span class="evidence-dots" aria-hidden="true">
    {Array.from({ length: count }).map(() => <span class="evidence-dot"></span>)}
  </span>
</span>
