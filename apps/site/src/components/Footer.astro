---
import { SUBMIT_URL, TAKEDOWN_URL } from '../lib/data';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container">
    <p>{t(lang, 'footer.disclaimer')}</p>
    <nav class="footer-links" aria-label={t(lang, 'footer.navLabel')}>
      <a href={localePath(lang, '/about')}>{t(lang, 'footer.about')}</a>
      <a href={localePath(lang, '/submit')}>{t(lang, 'footer.submit')}</a>
      <a href={TAKEDOWN_URL} rel="noopener noreferrer">{t(lang, 'footer.takedown')}</a>
      <a href={SUBMIT_URL} rel="noopener noreferrer">{t(lang, 'footer.form')}</a>
    </nav>
  </div>
</footer>
