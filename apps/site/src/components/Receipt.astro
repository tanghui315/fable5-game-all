---
import type { Game } from '@fable5/schema';
import { formatCost, formatDuration } from '../lib/data';
import { t, type Lang } from '../i18n';

interface Props {
  game: Game;
  lang: Lang;
  /** `hero` sits on the home image; `detail` sits in the game info column. */
  variant?: 'hero' | 'detail';
}

const { game, lang, variant = 'detail' } = Astro.props;
const generation = game.generation;
const rows = Boolean(
  generation &&
    (generation.turns !== undefined || generation.duration_min !== undefined || generation.tool),
);
---

{
  generation ? (
    <div class:list={['ticket-wrap', `ticket-wrap-${variant}`]}>
      <aside class="ticket" aria-label={t(lang, 'receipt.title')}>
        <p class="ticket-top">
          <span>{t(lang, 'receipt.admitOne')}</span>
          <span class="ticket-model">{game.model.name}</span>
        </p>

        {generation.prompt_url && (
          <p class="ticket-prompt">
            {t(lang, 'receipt.prompt')} ·{' '}
            <a class="ticket-link" href={generation.prompt_url} target="_blank" rel="noopener noreferrer">
              {t(lang, 'action.viewPrompt')}
            </a>
          </p>
        )}

        {rows && (
          <>
            <div class="ticket-perf" />
            <dl class="ticket-rows">
              {generation.turns !== undefined && (
                <div class="ticket-row">
                  <dt>{t(lang, 'receipt.turns')}</dt>
                  <dd>{generation.turns}</dd>
                </div>
              )}
              {generation.duration_min !== undefined && (
                <div class="ticket-row">
                  <dt>{t(lang, 'receipt.duration')}</dt>
                  <dd>{formatDuration(generation.duration_min, lang)}</dd>
                </div>
              )}
              {generation.tool && (
                <div class="ticket-row">
                  <dt>{t(lang, 'receipt.tool')}</dt>
                  <dd>{generation.tool}</dd>
                </div>
              )}
            </dl>
          </>
        )}

        {generation.cost_usd !== undefined && (
          <>
            <div class="ticket-perf" />
            <p class="ticket-total">
              <span>{t(lang, 'receipt.total')}</span>
              <b>{formatCost(generation.cost_usd)}</b>
            </p>
          </>
        )}
      </aside>
    </div>
  ) : (
    <p class="no-generation">{t(lang, 'receipt.missing')}</p>
  )
}
