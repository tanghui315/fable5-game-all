---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import { gamesByAuthor, getSiteData } from '../../lib/data';

export function getStaticPaths() {
  return getSiteData().authors.map((author) => ({
    params: { author: author.id },
    props: { id: author.id },
  }));
}

interface Props {
  id: string;
}

const { id } = Astro.props;
const author = getSiteData().authorById.get(id);
if (!author) throw new Error(`unknown author id: ${id}`);

const games = gamesByAuthor(author.id);
---

<BaseLayout title={author.name} description={`${author.name} 用 Fable 5.x 生成的网页游戏。`}>
  <header class="author-header">
    {
      author.avatar && (
        <img
          class="author-avatar author-avatar-large"
          src={author.avatar}
          alt=""
          width="72"
          height="72"
          loading="lazy"
        />
      )
    }
    <div>
      <h1 class="page-title author-title">{author.name}</h1>
      <div class="author-links">
        {
          author.github && (
            <a href={`https://github.com/${author.github}`} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          )
        }
        {
          author.x && (
            <a href={`https://x.com/${author.x}`} target="_blank" rel="noopener noreferrer">
              X
            </a>
          )
        }
        {
          author.website && (
            <a href={author.website} target="_blank" rel="noopener noreferrer">
              个人网站
            </a>
          )
        }
      </div>
    </div>
  </header>

  {
    games.length > 0 ? (
      <section aria-labelledby="author-games-title">
        <h2 class="section-title" id="author-games-title">
          作品
        </h2>
        <div class="grid-12 game-grid">
          {games.map((view) => (
            <GameCard view={view} />
          ))}
        </div>
      </section>
    ) : (
      <p class="empty-note">这个作者还没有可展示的作品。</p>
    )
  }
</BaseLayout>

<style>
  .author-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .author-avatar-large {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--crease);
  }

  .author-title {
    margin-bottom: var(--space-1);
  }

  .author-links {
    margin-top: 0;
  }

  .empty-note {
    color: var(--lead);
  }
</style>
