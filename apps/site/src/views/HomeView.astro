---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import Receipt from '../components/Receipt.astro';
import FilterBar from '../components/FilterBar';
import {
  cardMeta,
  gameSummary,
  heroSlides,
  gameTitle,
  latestGames,
  type GameView,
} from '../lib/data';
import { gamePath, kindLabel, localePath, t, tagLabel, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const games = latestGames();
const slides = heroSlides().map((view) => ({
  view,
  href: localePath(lang, gamePath(view.game.slug)),
  title: gameTitle(view, lang),
  summary: gameSummary(view, lang),
  meta: cardMeta(view, lang),
  authorHref: view.author ? localePath(lang, `/a/${view.author.id}`) : null,
  cover: view.coverUrl,
  preview: view.previewUrl,
  repoUrl: view.game.repo?.url ?? null,
}));
const items = games.map((view: GameView) => ({
  id: view.game.id,
  kind: view.game.kind,
  tags: view.game.tags,
  controls: view.game.controls,
  mobile: view.game.mobile,
  stars: view.repoStats?.stars ?? null,
  date: Date.parse(view.date) || 0,
}));

const usedTags = [...new Set(games.flatMap((view) => view.game.tags))];
const tagLabels = Object.fromEntries(usedTags.map((tag) => [tag, tagLabel(lang, tag)]));
const controlValues = ['keyboard', 'mouse', 'touch', 'gamepad'] as const;
const filterStrings = {
  kindLabel: t(lang, 'filter.kindLabel'),
  all: t(lang, 'filter.all'),
  game: kindLabel(lang, 'game'),
  demo: kindLabel(lang, 'demo'),
  tagsLabel: t(lang, 'filter.tagsLabel'),
  moreTags: t(lang, 'filter.moreTags'),
  fewerTags: t(lang, 'filter.fewerTags'),
  controlsLabel: t(lang, 'filter.controlsLabel'),
  mobile: t(lang, 'filter.mobile'),
  sort: t(lang, 'filter.sort'),
  latest: t(lang, 'filter.latest'),
  stars: t(lang, 'filter.stars'),
  empty: t(lang, 'filter.empty'),
  clear: t(lang, 'filter.clear'),
  controls: controlValues.map((value) => ({
    value,
    label: t(lang, `control.${value}`),
  })),
  tagLabels,
};
---

<BaseLayout title={t(lang, 'site.name')} lang={lang} path="/" isHome>
  {
    slides.length > 0 ? (
      <section class="hero" aria-labelledby="hero-title" data-hero>
        <div class="hero-panel">
          {slides.map((slide, index) => (
            <div
              class:list={['hero-slide', index === 0 && 'is-active']}
              data-hero-slide
              data-slide-index={index}
              aria-hidden={index === 0 ? undefined : 'true'}
              inert={index === 0 ? undefined : true}
            >
              <a class="hero-media" href={slide.href} tabindex="-1" aria-hidden="true">
                <img
                  class="hero-bg"
                  src={index === 0 ? (slide.preview ?? slide.cover) : undefined}
                  data-src={index === 0 ? undefined : (slide.preview ?? slide.cover)}
                  data-cover-src={slide.cover}
                  alt=""
                  width="640"
                  height="400"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
              <div class="hero-copy">
                <p class="hero-kicker">
                  <span>{t(lang, 'home.featured')}</span>
                  <span class="hero-kicker-separator" aria-hidden="true">·</span>
                  {slide.authorHref ? (
                    <a href={slide.authorHref}>
                      {t(lang, 'common.byAuthor', { author: slide.meta.author })}
                    </a>
                  ) : (
                    <span>{t(lang, 'common.byAuthor', { author: slide.meta.author })}</span>
                  )}
                </p>
                {index === 0 ? (
                  <h1 class="hero-title marquee" id="hero-title">
                    <a href={slide.href}>{slide.title}</a>
                  </h1>
                ) : (
                  <p class="hero-title marquee">
                    <a href={slide.href}>{slide.title}</a>
                  </p>
                )}
                <p class="hero-summary">{slide.summary}</p>
                <div class="hero-actions">
                  <a class="btn btn-primary" href={slide.href}>
                    {t(lang, 'action.playNow')}
                  </a>
                  {slide.repoUrl && (
                    <a
                      class="btn btn-ghost"
                      href={slide.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {t(lang, 'action.viewSource')}
                    </a>
                  )}
                </div>
              </div>
              <div class="hero-ticket">
                <Receipt game={slide.view.game} lang={lang} variant="hero" />
              </div>
            </div>
          ))}
          {slides.length > 1 && (
            <div
              class="hero-dots"
              role="group"
              aria-label={t(lang, 'home.featured')}
              data-hero-dots
            >
              {slides.map((slide, index) => (
                <button
                  type="button"
                  class:list={['hero-dot', index === 0 && 'is-active']}
                  data-hero-dot={index}
                  aria-label={slide.title}
                  aria-current={index === 0 ? 'true' : undefined}
                />
              ))}
            </div>
          )}
        </div>
      </section>
    ) : (
      <section class="empty-page">
        <h1>{t(lang, 'home.emptyTitle')}</h1>
        <p>{t(lang, 'home.emptyBody')}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={localePath(lang, '/submit')}>
            {t(lang, 'action.submitGame')}
          </a>
          <a class="btn btn-ghost" href={localePath(lang, '/about')}>
            {t(lang, 'home.emptyAbout')}
          </a>
        </div>
      </section>
    )
  }

  {
    games.length > 0 && (
      <section class="catalogue" aria-labelledby="catalogue-title">
        <div class="sec-head">
          <h2 class="section-title" id="catalogue-title">
            {t(lang, 'home.nowPlaying')}
          </h2>
          <FilterBar client:load items={items} lang={lang} strings={filterStrings} />
        </div>
        <noscript>
          <p class="noscript-note">{t(lang, 'home.noscript')}</p>
        </noscript>
        <div class="game-grid" data-game-grid>
          {games.map((view) => (
            <GameCard view={view} lang={lang} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (reduceMotion.matches) {
    // Only the visible slide has a src; the rest are lazy and stay untouched.
    document
      .querySelectorAll<HTMLImageElement>('img[data-cover-src]:not([data-src])')
      .forEach((image) => {
        const cover = image.dataset.coverSrc;
        if (cover) image.src = cover;
      });
  }

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')];

    if (slides.length > 1) {
      const INTERVAL_MS = 8_000;
      const DOT_PAUSE_MS = 30_000;
      const connection = (navigator as Navigator & { connection?: { saveData?: boolean } })
        .connection;
      const saveData = connection?.saveData === true;

      let current = 0;
      let pausedUntil = 0;
      let pointerInside = false;
      let focusInside = false;

      const slideImage = (index: number): HTMLImageElement | null =>
        slides[index]?.querySelector<HTMLImageElement>('img.hero-bg') ?? null;

      const loadImage = (index: number): void => {
        const image = slideImage(index);
        if (image === null || image.getAttribute('src')) return;
        const source = reduceMotion.matches
          ? (image.dataset.coverSrc ?? image.dataset.src)
          : image.dataset.src;
        if (source) image.src = source;
      };

      const warm = (index: number): void => {
        // Nothing rotates under reduced motion, so there is nothing to warm.
        if (reduceMotion.matches) return;
        const image = slideImage(index);
        const source = image?.dataset.src;
        if (!source || image?.getAttribute('src')) return;
        // Preload through a detached image so the slide stays unrendered.
        new Image().src = source;
      };

      const idle = (callback: () => void): void => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(callback, { timeout: 3000 });
        } else {
          window.setTimeout(callback, 1200);
        }
      };

      const show = (index: number): void => {
        if (index === current || slides[index] === undefined) return;
        loadImage(index);
        slides[current].classList.remove('is-active');
        slides[current].setAttribute('aria-hidden', 'true');
        slides[current].setAttribute('inert', '');
        current = index;
        slides[current].classList.add('is-active');
        slides[current].removeAttribute('aria-hidden');
        slides[current].removeAttribute('inert');
        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle('is-active', dotIndex === current);
          if (dotIndex === current) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        idle(() => warm((current + 1) % slides.length));
      };

      const canRotate = (): boolean =>
        !reduceMotion.matches &&
        !saveData &&
        !pointerInside &&
        !focusInside &&
        !document.hidden &&
        Date.now() >= pausedUntil;

      window.setInterval(() => {
        if (canRotate()) show((current + 1) % slides.length);
      }, INTERVAL_MS);

      hero.addEventListener('pointerenter', () => {
        pointerInside = true;
      });
      hero.addEventListener('pointerleave', () => {
        pointerInside = false;
      });
      hero.addEventListener('focusin', () => {
        focusInside = true;
      });
      hero.addEventListener('focusout', () => {
        focusInside = false;
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          show(index);
          pausedUntil = Date.now() + DOT_PAUSE_MS;
        });
      });

      idle(() => warm(1 % slides.length));
    }
  }

  if (finePointer.matches && !reduceMotion.matches) {
    document.querySelectorAll<HTMLElement>('[data-preview-src]').forEach((preview) => {
      const card = preview.closest<HTMLElement>('.game-card');
      if (!card) return;
      card.addEventListener('pointerenter', () => {
        if (!preview.getAttribute('src')) {
          const source = preview.dataset.previewSrc;
          if (source) preview.setAttribute('src', source);
        }
        card.classList.add('is-previewing');
      });
      card.addEventListener('pointerleave', () => {
        card.classList.remove('is-previewing');
      });
    });
  }
</script>
