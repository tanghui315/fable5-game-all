---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GITHUB_REPO, SUBMIT_URL } from '../lib/data';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout
  title={t(lang, 'submit.title')}
  description={t(lang, 'submit.description')}
  lang={lang}
  path="/submit"
>
  <h1 class="page-title">{t(lang, 'submit.title')}</h1>

  <div class="prose">
    <p class="lede">{t(lang, 'submit.lede')}</p>
    <p>{t(lang, 'submit.check')}</p>
    <p>{t(lang, 'submit.fields')}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={SUBMIT_URL} target="_blank" rel="noopener noreferrer">
        {t(lang, 'action.submitGame')}
      </a>
      <a class="btn btn-ghost" href={localePath(lang, '/about')}>{t(lang, 'submit.about')}</a>
    </div>
    <p>
      {t(lang, 'submit.repoBefore')}<a href={GITHUB_REPO} rel="noopener noreferrer"
        >{t(lang, 'submit.repoLink')}</a
      >{t(lang, 'submit.repoAfter')}
    </p>
  </div>
</BaseLayout>
