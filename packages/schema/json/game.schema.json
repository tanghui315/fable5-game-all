{
  "$ref": "#/definitions/Game",
  "definitions": {
    "Game": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*--[a-z0-9][a-z0-9-]*--[a-z0-9][a-z0-9-]*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "game",
            "demo"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "archived"
          ]
        },
        "title": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "zh",
            "en"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "zh",
            "en"
          ],
          "additionalProperties": false
        },
        "author": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "repo": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "path": {
              "type": "string"
            },
            "license": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "play": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "embeddable": {
              "type": "boolean"
            },
            "mirror_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "url",
            "embeddable"
          ],
          "additionalProperties": false
        },
        "media": {
          "type": "object",
          "properties": {
            "cover": {
              "type": "string",
              "minLength": 1
            },
            "preview": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "cover"
          ],
          "additionalProperties": false
        },
        "genre": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "keyboard",
              "mouse",
              "touch",
              "gamepad"
            ]
          }
        },
        "mobile": {
          "type": "boolean"
        },
        "model": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^fable-5(?:\\.[0-9]+)+$"
            },
            "evidence": {
              "type": "string",
              "enum": [
                "L1",
                "L2",
                "L3"
              ]
            },
            "evidence_notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "evidence"
          ],
          "additionalProperties": false
        },
        "generation": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "prompt_url": {
              "type": "string",
              "format": "uri"
            },
            "turns": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "duration_min": {
              "type": "number",
              "minimum": 0
            },
            "runs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "discovered_by": {
              "type": "string",
              "enum": [
                "seed",
                "github-search",
                "submission",
                "hn",
                "manual"
              ]
            },
            "discovered_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "published_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "discovered_by",
            "discovered_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "slug",
        "kind",
        "status",
        "title",
        "summary",
        "author",
        "play",
        "media",
        "genre",
        "tags",
        "controls",
        "mobile",
        "model",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
